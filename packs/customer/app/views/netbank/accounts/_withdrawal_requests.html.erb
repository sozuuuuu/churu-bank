<%# 出金依頼（窓口取引、TODO の Q1）のカード: 依頼のフォームと、自分の依頼の状態。口座ページに1か所だけ差し込む。
    見た目は既存のクラス（.card / .form / .button / .confirm / .badge）だけ %>
<section class="card" id="withdrawal-requests">
  <h2><%= icon(:wallet, size: 22) %><span class="marker">出金の依頼</span></h2>
  <% if account.active? %>
    <%= turbo_frame_tag "withdrawal_request", src: new_account_withdrawal_request_path(account) do %>
      <p class="muted">読み込み中…</p>
    <% end %>
  <% else %>
    <p class="muted">この口座は<%= account.status_label %>なので出金を依頼できません。</p>
  <% end %>

  <% if requests.any? %>
    <h3>最近の依頼</h3>
    <ul class="pending-transfers">
      <% requests.each do |request| %>
        <li id="<%= dom_id(request) %>">
          <span class="badge"><%= request.status_label %></span>
          <strong><%= churu(request.amount) %></strong>
          <span class="muted"><%= jp_time(request.requested_at) %> <%= request.memo %></span>
          <% if request.reject_reason %><span class="muted">（<%= request.reject_reason %>）</span><% end %>
          <% if request.open? %>
            <%= button_to "取り消す", account_withdrawal_request_path(account, request), method: :delete, class: "button small",
                          form: { data: { turbo_confirm: "#{request.amount} ちゅ〜るの出金依頼を取り消しますか？" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
