<%= turbo_frame_tag "reversal" do %>
  <div class="confirm reversal-panel">
    <h3>取消（逆仕訳）の確認</h3>
    <p class="muted">まだ取り消していません。内容を確認してください。元の行は消えずに残り、逆向きの行が増えます。</p>
    <dl>
      <%= render "admin/accounts/reversals/entry", entry: @entry %>
      <dt>理由</dt><dd><%= @reason %></dd>
      <dt>残高</dt>
      <dd><%= churu(@outcome.balance_before) %> → <strong><%= churu(@outcome.balance_after) %></strong></dd>
      <dt>発生するイベント</dt>
      <dd><code><%= @outcome.events.map { it.class.name.demodulize }.join(", ") %></code></dd>
    </dl>

    <%# 確定したら口座ページごと更新したいので、Frame の外（_top）へ遷移させる %>
    <%= form_with url: admin_account_reversals_path(@account), data: { turbo_frame: "_top" } do |f| %>
      <%= f.hidden_field :event_id, value: @entry.event_id %>
      <%= f.hidden_field :reason, value: @reason %>
      <%= f.submit "取消を確定する", class: "button primary" %>
      <%= link_to "戻る", new_admin_account_reversal_path(@account, event_id: @entry.event_id, reason: @reason),
                  class: "button" %>
    <% end %>
  </div>
<% end %>
