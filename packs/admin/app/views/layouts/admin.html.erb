<%# 管理画面のメニューと行員の名前・ログアウト（staff_header）を入れて、packs/ui の application レイアウトで描く %>
<%= staff_header %>
<% content_for :head do %>
  <%# 管理画面だけの見た目（packs/admin/app/assets/stylesheets/admin/admin.css）。利用者画面へ移ったら外れる %>
  <%= stylesheet_link_tag "admin/admin", "data-turbo-track": "dynamic" %>
<% end %>
<% content_for :nav do %>
  <span class="badge">管理画面</span>
  <%= link_to "口座一覧", admin_accounts_path %>
  <%# 窓口（出金依頼）と承認待ち（二人承認）。件数があればバッジ %>
  <%= link_to admin_withdrawal_requests_path do %>窓口<% if (n = WithdrawalRequest.open.count).positive? %> <span class="badge"><%= n %></span><% end %><% end %>
  <%= link_to "整理券とチャット", counter_admin_queue_path %><%# packs/counter_admin（ルート名だけ。定数の依存はない） %>
  <%= link_to admin_approvals_path do %>承認待ち<% if (n = ApprovalRequest.pending.count).positive? %> <span class="badge"><%= n %></span><% end %><% end %>
  <%= link_to "振込一覧", admin_transfers_path %>
  <%= link_to "利息", admin_interest_path %>
  <%= link_to "口座開設", new_admin_account_path %>
  <%= link_to "イベント", event_viewer_events_path %>
  <%= link_to "商店の管理", shop_admin_products_path %>
  <%= link_to "お知らせ", notices_admin_notices_path %>
<% end %>
<%= render template: "layouts/application" %>
