<% content_for :title, "行員ログイン | ちゅーる銀行" %>
<% content_for :home_path, new_staff_session_path %>
<% content_for :nav do %><span class="badge">行員</span><% end %>

<h1>行員ログイン</h1>

<%= form_with url: staff_session_path, class: "card form login" do |form| %>
  <label>
    メールアドレス
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                         value: params[:email_address] %>
  </label>
  <label>
    パスワード
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </label>
  <%= form.submit "ログイン", class: "button primary" %>
<% end %>
