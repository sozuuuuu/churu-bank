<%= turbo_frame_tag "hold" do %>
  <div class="confirm reversal-panel">
    <h3>保留中の振込を通す（確認）</h3>
    <p class="muted">まだ通していません。通すと、振込先へ入金します（引き落としは済んでいます）。</p>
    <% @outcome.warnings.each do |warning| %>
      <p class="hint"><%= warning %></p>
    <% end %>
    <dl>
      <%= render "admin/transfers/reversals/transfer", transfer: @transfer %>
      <dt>振込先の残高</dt>
      <dd><%= churu(@outcome.balance_before) %> → <strong><%= churu(@outcome.balance_after) %></strong>（入金のあと）</dd>
      <dt>発生するイベント</dt>
      <dd><code><%= @outcome.events.map { it.class.name.demodulize }.join(", ") %></code>（このあとジョブが TransferCredited, TransferCompleted）</dd>
    </dl>

    <%= form_with url: admin_transfer_release_path(@transfer), data: { turbo_frame: "_top" } do |f| %>
      <%= f.submit "通す", class: "button primary" %>
      <%= link_to "戻る", new_admin_transfer_release_path(@transfer), class: "button" %>
    <% end %>
  </div>
<% end %>
