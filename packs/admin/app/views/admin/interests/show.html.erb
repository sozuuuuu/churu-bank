<% content_for :title, "利息 | ちゅーる銀行" %>

<%# 利息のジョブやほかのタブで口座が動いたら、この画面も morph で更新される %>
<%= turbo_stream_from "accounts" %>

<h1>利息</h1>

<section class="card">
  <%= render "admin/interests/rate" %>
  <p class="muted small">
    ふだんは毎日 0:05 にジョブが前日分を払います。止まっていた日の分などを、ここから手で払えます。
    同じ日の利息は1口座につき1回だけで、2回目は何もしません。
  </p>
</section>

<section class="card">
  <h2>全口座に払う</h2>
  <%# 入力 → 確認 → 確定 の画面遷移は、この Frame の中だけで起きる %>
  <% if @status_rows %>
    <% paid, unpaid = @status_rows.count { it.state == :paid }, @status_rows.count(&:pay?) %>
    <p class="interest-status <%= unpaid.zero? ? "flash flash-notice" : "hint" %>">
      <%= jp_date(@date) %> の利息: 支払い済み <strong><%= paid %></strong> 口座 ・ まだ払っていない <strong><%= unpaid %></strong> 口座
      <span class="muted small">（残高 0・解約済みは対象外）</span>
    </p>
  <% end %>
  <%= turbo_frame_tag "interest" do %>
    <%= render "admin/interests/form", url: admin_interest_path %>
  <% end %>
</section>
