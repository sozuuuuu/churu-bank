<%# ねこテーマ（packs/ui/app/assets/stylesheets/ui/cat.css）を入れて、application レイアウトで描く。
    利用者向けの画面（customer、利用者が見る商店・お知らせ、利用者のログイン）用。body.cat-theme の下だけに効くので管理画面には影響しない。
    メニューは呼び出す側のレイアウトで content_for :nav に入れてから render template: "layouts/cat" する。
    画面下にねこのセリフ窓（ui/_serif。セリフはページのテンプレートで cat_says）を出す。helper Ui::ThemeHelper が要る %>
<% content_for :body_class, "cat-theme" %>
<% content_for :head do %>
  <%# ページ遷移を View Transitions API でつなぐ（Turbo 8 が対応） %>
  <meta name="view-transition" content="same-origin">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet"
        data-turbo-track="dynamic">
  <%# dynamic: 管理画面へ移ったら Turbo がこの CSS を外す %>
  <%= stylesheet_link_tag "ui/cat", "data-turbo-track": "dynamic" %>
<% end %>
<% content_for :brand_mark, sparkle(size: 20, css: "brand-sparkle") %>
<%# セリフ窓は本文より前に置く（ページの出来事が cat:say を投げるとき、受け取る側がもうつながっているように） %>
<% content_for :overlay, render("ui/serif") %>
<%= render template: "layouts/application" %>
