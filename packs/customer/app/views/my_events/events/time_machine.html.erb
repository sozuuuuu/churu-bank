<% content_for :title, "タイムマシン | わたしの出来事 | ちゅーる銀行" %>
<% cat_says "通帳は、出来事を順番に足していったものなんだにゃ。つまみを動かすと、むかしの残高にもどれるにゃ。「コマ送り」で1つずつ足してみるにゃ。" %>

<%= render "my_events/events/head" %>

<section class="hero card tone my-events-hero">
  <%= sparkle(size: 26, css: "hero-star") %>
  <h1><%= icon(:clock, size: 26) %><span class="marker">タイムマシン</span></h1>
  <p><strong>いまの残高 = はじめの出来事から順に足し合わせた結果。</strong></p>
</section>

<%= form_with url: event_time_machine_path, method: :get, class: "card ev-filters", data: { controller: "autosubmit" } do |f| %>
  <label>口座
    <%= f.select :account, @accounts.map { [ "#{it.number}（#{it.holder_name}）", it.number ] }, { selected: @account&.number },
                 data: { action: "change->autosubmit#submit" } %>
  </label>
  <% if @machine %>
    <fieldset class="ev-basis">
      <legend>並べ方</legend>
      <% EventLens::TimeMachine::BASES.each do |key, label| %>
        <label><%= f.radio_button :basis, key, checked: @machine.basis == key, data: { action: "change->autosubmit#submit" } %> <%= label %></label>
      <% end %>
    </fieldset>
  <% end %>
  <noscript><%= f.submit "見る", class: "button", name: nil %></noscript>
<% end %>

<% if @machine.nil? %>
  <p class="empty">口座がまだありません。</p>
<% else %>
  <%= render "event_lens/time_machine", machine: @machine %>
<% end %>
