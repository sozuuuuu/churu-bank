<% content_for :title, "口座一覧 | ちゅーる銀行" %>

<%# どの口座が更新されても、この一覧が morph で更新される %>
<%= turbo_stream_from "accounts" %>
<% @accounts.each do |account| %>
  <%= turbo_stream_from account %>
<% end %>

<h1>口座一覧</h1>

<% if @accounts.empty? %>
  <p class="empty">まだ口座がありません。<%= link_to "口座を開設する", new_admin_account_path %></p>
<% else %>
  <table class="table">
    <thead>
      <tr><th>口座番号</th><th>名義</th><th>状態</th><th class="num">残高</th></tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr id="<%= dom_id(account) %>">
          <td><%= link_to account.number, admin_account_path(account) %></td>
          <td><%= account.holder_name %></td>
          <td><span class="badge badge-<%= account.status %>"><%= account.status_label %></span></td>
          <td class="num"><%= churu(account.balance) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
