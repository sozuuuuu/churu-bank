<% content_for :title, "#{@notice.title} | ちゅーる銀行" %>
<% if @notice.important? %>
  <% cat_says "重要なお知らせにゃ！ 最後まで読んでほしいにゃ。", face: :surprised %>
<% else %>
  <% cat_says "銀行からのお手紙を持ってきたにゃ。" %>
<% end %>

<article class="card tone notice-letter-card notice-kind-<%= @notice.kind %><%= " is-important" if @notice.important? %>">
  <div class="notice-letter-head">
    <span class="notice-row-icon"><%= notice_kind_icon(@notice, size: 26) %></span>
    <div>
      <span class="notice-bubble-head">
        <span class="notice-chip"><%= @notice.kind_label %></span>
        <% if @notice.important? %><span class="notice-important">重要</span><% end %>
      </span>
      <h1><%= @notice.title %></h1>
      <p class="muted small">
        <%= jp_time(@notice.starts_at) %> から<% if @notice.ends_at %> <%= jp_time(@notice.ends_at) %> まで<% end %>
      </p>
    </div>
  </div>

  <div class="notice-body">
    <% if @notice.body.present? %>
      <%= simple_format(@notice.body) %>
    <% else %>
      <p class="muted">（本文はありません）</p>
    <% end %>
  </div>

  <div class="notice-actions">
    <%= link_to notices_path, class: "button" do %><%= icon(:back) %> お知らせの一覧<% end %>
    <% if @notice.important? && !inbox.dismissed?(@notice) %>
      <%= button_to notice_dismissal_path(@notice), class: "button primary" do %><%= icon(:check) %> 読みました（吹き出しを閉じる）<% end %>
    <% end %>
  </div>
</article>
