<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ちゅーる銀行" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ちゅーる銀行">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# broadcasts_refreshes で届いた更新を、ページ全体の差し替えではなく morph で反映する %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %>🐟 ちゅーる銀行<% end %>
      <%# メニューは画面のパックごと（packs/admin・packs/customer・packs/shop の layouts）で content_for :nav に入れる %>
      <nav>
        <%= yield :nav %>
        <% if Current.user %>
          <span class="muted"><%= Current.user.name %></span>
          <%= button_to "ログアウト", session_path, method: :delete, class: "link" %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
