<% content_for :title, "#{@account.holder_name} の口座 | ちゅーる銀行" %>

<%# ほかのタブや MCP、振込のジョブから更新があっても、この画面が morph で更新される %>
<%= turbo_stream_from @account %>

<div class="account-head card">
  <div>
    <p class="muted">
      口座番号 <%= @account.number %> ・ 開設 <%= jp_date(@account.opened_on) %>
      ・ 持ち主 <%= @owners.map(&:name).join("、").presence || "なし" %>
    </p>
    <h1><%= @account.holder_name %> <span class="badge badge-<%= @account.status %>"><%= @account.status_label %></span></h1>
  </div>
  <div class="account-actions">
    <p class="balance"><%= churu(@account.balance) %></p>
    <% case @account.status %>
    <% when "active" %>
      <%= button_to "凍結する", admin_account_freeze_path(@account), class: "button small",
                    form: { data: { turbo_confirm: "#{@account.holder_name} の口座を凍結しますか？" } } %>
    <% when "frozen" %>
      <%= button_to "凍結を解除する", admin_account_freeze_path(@account), method: :delete, class: "button small" %>
    <% end %>
  </div>
</div>

<div class="grid">
  <section class="card">
    <h2>入出金</h2>
    <% if @account.active? %>
      <%# 入力 → 確認 → 確定 の画面遷移は、この Frame の中だけで起きる %>
      <%= turbo_frame_tag "transaction", src: new_admin_account_transaction_path(@account) do %>
        <p class="muted">読み込み中…</p>
      <% end %>
    <% else %>
      <p class="muted">この口座は<%= @account.status_label %>なので入出金できません。</p>
    <% end %>
  </section>

  <section class="card">
    <h2>振込</h2>
    <% if @account.active? %>
      <%= turbo_frame_tag "transfer", src: new_admin_account_transfer_path(@account), loading: :lazy do %>
        <p class="muted">読み込み中…</p>
      <% end %>
    <% else %>
      <p class="muted">この口座は<%= @account.status_label %>なので振り込めません。</p>
    <% end %>
  </section>

  <section class="card">
    <h2>時点指定の残高</h2>
    <%# Frame だけ差し替えつつ、URL（?date=）も進める。morph で更新されても同じ日付で描き直される %>
    <%= form_with url: balance_admin_account_path(@account), method: :get,
                  data: { turbo_frame: "balance", turbo_action: "advance", controller: "autosubmit" } do |f| %>
      <%= f.date_field :date, value: @date, data: { action: "change->autosubmit#submit" } %>
    <% end %>
    <%= turbo_frame_tag "balance", src: balance_admin_account_path(@account, date: @date) %>
  </section>

  <section class="card">
    <h2>利息</h2>
    <% if @account.status == "closed" %>
      <p class="muted">解約済みの口座には利息を払いません。</p>
    <% else %>
      <%= turbo_frame_tag "interest", src: new_admin_account_interest_path(@account), loading: :lazy do %>
        <p class="muted">読み込み中…</p>
      <% end %>
    <% end %>
  </section>
</div>

<section class="card">
  <h2>通帳</h2>
  <%# 行の「取消」「組戻し」を押すと、理由の入力 → 確認 → 確定 がこの Frame の中で動く %>
  <%= turbo_frame_tag "reversal", autoscroll: true, data: { autoscroll_block: "center" } %>
  <% if @entries.empty? %>
    <p class="muted">まだ取引はありません。</p>
  <% else %>
    <table class="table">
      <thead>
        <tr><th>記帳日時</th><th>起算日</th><th>取引</th><th>相手・メモ</th><th class="num">金額</th><th class="num">残高</th><th>経路</th><th></th></tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <% transfer = @transfers[entry.transfer_id] %>
          <tr id="<%= dom_id(entry) %>" class="<%= "reversed" if entry.reversed? %> <%= "reversal" if entry.reversal? %>">
            <td><%= jp_time(entry.booked_at) %></td>
            <td class="<%= "backdated" if entry.backdated? %>"><%= jp_date(entry.value_date) %></td>
            <td>
              <%= entry.kind_label %>
              <% if transfer && entry.kind == "transfer_out" %>
                <%= render "transfers/status", transfer: %>
              <% end %>
              <%= render "admin/accounts/reversal_link", entry: %>
              <% if transfer&.status == "reversed" && entry.kind.in?(%w[transfer_out transfer_in]) %>
                <div class="small muted">
                  <span class="badge badge-reversed">組戻し済み</span> <%= jp_time(transfer.reversed_at) %> <%= transfer.reversal_reason %>
                </div>
              <% end %>
            </td>
            <td>
              <% if entry.counterparty %>
                <%= link_to @holders.fetch(entry.counterparty, entry.counterparty), admin_account_path(entry.counterparty) %>
              <% end %>
              <span class="muted"><%= entry.memo %></span>
            </td>
            <td class="num <%= entry.amount.negative? ? "minus" : "plus" %>"><%= churu(entry.amount, signed: true) %></td>
            <td class="num"><%= churu(entry.balance_after) %></td>
            <td class="muted"><%= entry.actor %></td>
            <td>
              <% if entry.reversible? %>
                <%= link_to "取消", new_admin_account_reversal_path(@account, event_id: entry.event_id),
                            class: "button small", data: { turbo_frame: "reversal" } %>
              <% elsif transfer&.reversible? && entry.kind.in?(%w[transfer_out transfer_in]) %>
                <%= link_to "組戻し", new_admin_transfer_reversal_path(transfer, back_to: @account.number),
                            class: "button small", data: { turbo_frame: "reversal" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
