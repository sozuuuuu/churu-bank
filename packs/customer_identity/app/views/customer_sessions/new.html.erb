<% content_for :title, "ログイン | ちゅーる銀行" %>
<% content_for :home_path, new_customer_session_path %>
<% if flash[:alert] %>
  <% cat_says "ログインできなかったにゃ… メールアドレスとパスワードをもう一度たしかめてにゃ。", face: :sad %>
<% else %>
  <% cat_says "いらっしゃいにゃ。ちゅーる銀行のねこ、ちゅーるにゃ。メールアドレスとパスワードでログインしてにゃ。" %>
<% end %>

<header class="page-title">
  <p>ようこそ</p>
  <h1><span class="marker">ちゅーる銀行にログイン</span></h1>
</header>

<%= form_with url: customer_session_path, class: "card tone form login" do |form| %>
  <label>
    メールアドレス
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                         value: params[:email_address] %>
  </label>
  <label>
    パスワード
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </label>
  <%= form.button class: "button primary" do %><%= icon(:key) %> ログイン<% end %>
<% end %>
