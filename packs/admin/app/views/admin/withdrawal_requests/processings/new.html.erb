<%= turbo_frame_tag "counter" do %>
  <div class="confirm reversal-panel">
    <h3>出金の確認</h3>
    <% if @error %>
      <p class="flash flash-alert"><%= @error %></p>
    <% end %>
    <dl>
      <%= render "admin/withdrawal_requests/request", request: @request %>
      <% if @outcome %>
        <dt>残高</dt>
        <dd><%= churu(@outcome.balance_before) %> → <strong><%= churu(@outcome.balance_after) %></strong></dd>
        <dt>発生するイベント</dt>
        <dd><code><%= @outcome.events.map { it.class.name.demodulize }.join(", ") %></code></dd>
      <% end %>
    </dl>

    <% if @outcome && @request.open? %>
      <p class="muted">まだ出金していません。現金を渡す前に、内容を確認してください。</p>
      <%= form_with url: admin_withdrawal_request_processing_path(@request), data: { turbo_frame: "_top" } do |f| %>
        <div class="actions">
          <%= f.submit "出金を確定する", class: "button primary" %>
          <%= link_to "やめる", admin_withdrawal_requests_path, class: "button", data: { turbo_frame: "_top" } %>
        </div>
      <% end %>
    <% else %>
      <% unless @request.open? %>
        <p class="muted">この依頼は「<%= @request.status_label %>」なので出金できません。</p>
      <% end %>
      <div class="actions">
        <% if @request.open? %>
          <%= link_to "断る", new_admin_withdrawal_request_rejection_path(@request), class: "button" %>
        <% end %>
        <%= link_to "閉じる", admin_withdrawal_requests_path, class: "button", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>
<% end %>
