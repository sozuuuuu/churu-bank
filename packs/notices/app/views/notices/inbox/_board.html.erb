<%# ページの頭のお知らせの吹き出し。開くと既読になるので、ホバーでの先読み（Turbo の prefetch）はしない。
    新しいお知らせが出たら Notices::RefreshJob の refresh で morph され、新しく入った吹き出しだけが「ぽん」と出る（CSS）。
    ねこのセリフ窓に知らせる（だいじなものはびっくり顔）のは notices--inbox（Stimulus） %>
<%= customer_stream_from "notices" %>
<%= customer_stream_from current_customer, :notices %>
<% notices = bubble ? inbox.bubble : [] %>
<% shown = notices.first(3) %>
<section id="notice-board" class="notice-board" aria-label="銀行からのお知らせ"
         data-controller="notices--inbox" data-turbo-prefetch="false" <%= "hidden" if shown.empty? %>>
  <p class="notice-board-head"><%= icon(:bell, size: 18) %> 銀行からのお知らせ</p>
  <ol>
    <% shown.each do |notice| %>
      <li id="<%= dom_id(notice, :bubble) %>" data-notice-id="<%= notice.id %>"
          class="notice-bubble notice-kind-<%= notice.kind %><%= " is-important" if notice.important? %><%= " is-unread" unless inbox.read?(notice) %>">
        <span class="notice-bubble-icon"><%= notice_kind_icon(notice, size: 20) %></span>
        <span class="notice-bubble-main">
          <span class="notice-bubble-head">
            <span class="notice-chip"><%= notice.kind_label %></span>
            <% if notice.important? %><span class="notice-important">重要</span><% end %>
            <% unless inbox.read?(notice) %><span class="notice-new">NEW</span><% end %>
          </span>
          <%= link_to notice.title, notice_path(notice), class: "notice-bubble-title" %>
        </span>
        <%= button_to notice_dismissal_path(notice), class: "notice-close", form_class: "notice-close-form",
                      title: "閉じる", "aria-label": "「#{notice.title}」を閉じる" do %><%= icon(:close, size: 16) %><% end %>
      </li>
    <% end %>
  </ol>
  <% if notices.size > shown.size %>
    <%= link_to "ほかに #{notices.size - shown.size} 件のお知らせ", notices_path, class: "notice-more" %>
  <% end %>
</section>
