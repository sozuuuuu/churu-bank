<%= turbo_frame_tag "transaction" do %>
  <%= form_with url: account_transactions_path(@account), class: "form",
                data: { controller: "amount" } do |f| %>
    <% if @error %>
      <p class="flash flash-alert"><%= @error %></p>
    <% end %>

    <div class="segmented">
      <label><%= f.radio_button :kind, "deposit", checked: @form[:kind] == "deposit" %> 入金</label>
      <label><%= f.radio_button :kind, "withdrawal", checked: @form[:kind] == "withdrawal" %> 出金</label>
    </div>

    <label>
      金額（ちゅ〜る）
      <%= f.number_field :amount, value: @form[:amount], min: 1, step: 1, required: true,
                         data: { amount_target: "input" } %>
    </label>
    <div class="presets">
      <% [10, 50, 100, 500].each do |n| %>
        <button type="button" class="chip" data-action="amount#add" data-amount-value-param="<%= n %>">+<%= n %></button>
      <% end %>
      <button type="button" class="chip" data-action="amount#clear">クリア</button>
    </div>

    <label>
      メモ
      <%= f.text_field :memo, value: @form[:memo], placeholder: "例: おこづかい" %>
    </label>

    <details <%= "open" if @form[:value_date] %>>
      <summary>起算日を指定する（さかのぼって記帳）</summary>
      <%= f.date_field :value_date, value: @form[:value_date], max: Date.current %>
    </details>

    <%# まずドライランで確認する。確定は次の画面で %>
    <%= f.submit "確認する", name: "preview", class: "button primary" %>
  <% end %>
<% end %>
