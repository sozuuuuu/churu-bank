<%# 利用者画面: メニューと利用者の名前・ログアウト（customer_header）を入れて、ねこテーマのレイアウト（packs/ui の layouts/cat）で描く。
    行員の画面へのリンクは出さない（行員と利用者はアカウントもログインも別） %>
<%= customer_header %>
<% content_for :nav do %>
  <%= link_to accounts_path, "aria-current": ("page" if controller_path.start_with?("netbank")) do %><%= icon(:wallet, size: 18) %> わたしの口座<% end %>
  <%= link_to counter_path do %><%= icon(:ticket, size: 18) %> 窓口<% end %>
  <%= link_to shop_root_path, "aria-current": ("page" if controller_path.start_with?("shop")) do %><%= icon(:cart, size: 18) %> ちゅ〜る商店<% end %>
  <%= link_to events_path, "aria-current": ("page" if controller_path.start_with?("my_events")) do %><%= icon(:clock, size: 18) %> わたしの出来事<% end %>
<% end %>
<%# 銀行からのお知らせ（packs/notices）: メニューの「お知らせ」とバッジ、ページの頭のねこの吹き出し、ライブ更新 %>
<%= notices_inbox %>
<%# ねこの実況（MyEvents::CommentaryJob）: 自分の口座にかかわる出来事が起きたら、セリフ窓のちゅーるがしゃべる。
    行は隠しておく（セリフ窓が読み上げる）。ページを移っても・morph でも、しゃべる順番の待ち行列を消さないように permanent %>
<% if current_customer %>
  <% content_for :overlay do %>
    <%= customer_stream_from current_customer, :commentary %>
    <div id="cat_commentary_feed" data-turbo-permanent data-controller="event-lens--commentary">
      <ol id="<%= MyEvents::CommentaryJob::TARGET %>" hidden data-event-lens--commentary-target="list"></ol>
    </div>
  <% end %>
<% end %>
<%= render template: "layouts/cat" %>
