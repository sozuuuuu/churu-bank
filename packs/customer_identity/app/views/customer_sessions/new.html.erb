<% content_for :title, "ログイン | ちゅーる銀行" %>
<% content_for :home_path, new_customer_session_path %>
<% content_for :entrance, link_to("行員の入り口", new_staff_session_path, class: "entrance") %>
<% if flash[:alert] %>
  <% cat_says "だれの口座を見るか、えらんでほしいにゃ。", face: :sad %>
<% else %>
  <% cat_says "いらっしゃいにゃ。ちゅーる銀行のねこ、ちゅーるにゃ。だれの口座を見るにゃ？" %>
<% end %>

<header class="page-title">
  <p>ようこそ</p>
  <h1><span class="marker">ちゅーる銀行に入る</span></h1>
</header>

<%# パスワードは使わない（学習用）。利用者を選ぶだけで、その人としてログインする %>
<%= form_with url: customer_session_path, class: "card tone form login" do |form| %>
  <% if @customers.empty? %>
    <p class="muted">利用者がまだいません。<code>bin/rails db:seed</code> で開発用の利用者が入ります。</p>
  <% else %>
    <label>
      だれとして入る？
      <%= form.select :customer_id, @customers.map { [ "#{it.name} さん", it.id ] },
                      { include_blank: "選んでください" }, required: true, autofocus: true %>
    </label>
    <%= form.button class: "button primary" do %><%= icon(:key) %> この人で入る<% end %>
  <% end %>
<% end %>
