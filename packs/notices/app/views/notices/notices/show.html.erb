<% content_for :title, "#{@notice.title} | ちゅーる銀行" %>

<article class="card notice-letter-card notice-kind-<%= @notice.kind %><%= " is-important" if @notice.important? %>">
  <div class="notice-letter-head">
    <%= render "notices/inbox/cat" %>
    <div>
      <span class="notice-bubble-head">
        <span class="notice-chip"><%= @notice.kind_icon %> <%= @notice.kind_label %></span>
        <% if @notice.important? %><span class="notice-important">だいじ</span><% end %>
      </span>
      <h1><%= @notice.title %></h1>
      <p class="muted small">
        <%= jp_time(@notice.starts_at) %> から<% if @notice.ends_at %> <%= jp_time(@notice.ends_at) %> まで<% end %>
      </p>
    </div>
  </div>

  <div class="notice-body">
    <% if @notice.body.present? %>
      <%= simple_format(@notice.body) %>
    <% else %>
      <p class="muted">（本文はありません）</p>
    <% end %>
  </div>

  <div class="notice-actions">
    <%= link_to "← お知らせの一覧", notices_path, class: "button" %>
    <% if @notice.important? && !inbox.dismissed?(@notice) %>
      <%= button_to "読んだにゃ（吹き出しを閉じる）", notice_dismissal_path(@notice), class: "button primary" %>
    <% end %>
  </div>
</article>
