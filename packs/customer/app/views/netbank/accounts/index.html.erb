<% content_for :title, "わたしの口座 | ちゅーる銀行" %>

<%# 自分の口座のどれかが更新されたら、この一覧が morph で更新される %>
<% @accounts.each do |account| %>
  <%= customer_stream_from account %>
<% end %>

<section class="hello">
  <%= render "netbank/cat" %>
  <div class="bubble">
    <p class="bubble-sub">おかえりにゃ</p>
    <h1><%= current_customer.name %> さんの口座</h1>
  </div>
</section>

<% if @accounts.empty? %>
  <p class="empty">まだ口座がありません。口座の開設は窓口（行員）にご相談ください。</p>
<% else %>
  <ul class="account-cards">
    <% @accounts.each_with_index do |account, i| %>
      <li id="<%= dom_id(account) %>" style="--i: <%= i %>">
        <%= link_to account_path(account), class: "account-card" do %>
          <span class="account-card-head">
            <span class="paw" aria-hidden="true">🐾</span>
            <span class="muted">口座番号 <%= account.number %></span>
            <span class="badge badge-<%= account.status %>"><%= account.status_label %></span>
          </span>
          <span class="account-card-name"><%= account.holder_name %></span>
          <%= render "netbank/accounts/amount", account: %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
