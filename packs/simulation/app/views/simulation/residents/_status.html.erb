<%# 町のいまの様子。町を動かす係が Board#status で書き換える（ボタンは CSRF の印が要るので、ここには入れない） %>
<div id="<%= Simulation::Board::STATUS_TARGET %>" class="town-status <%= "is-running" if control.town_running %>">
  <strong><%= control.status_label %></strong>
  <span class="muted small">速さ: <%= Simulation::Control::SPEEDS[control.seconds_per_day] %></span>
</div>
