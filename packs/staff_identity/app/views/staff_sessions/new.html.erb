<% content_for :title, "行員ログイン | ちゅーる銀行" %>
<% content_for :home_path, new_staff_session_path %>
<% content_for :nav do %><span class="badge">行員</span><% end %>
<% content_for :entrance, link_to("お客さまの入り口", new_customer_session_path, class: "entrance") %>

<h1>行員ログイン</h1>

<%# 学習用なのでパスワードは使わず、行員を選ぶだけで入る（二人承認を試すために行員を切り替えやすく） %>
<%= form_with url: staff_session_path, class: "card form login" do |form| %>
  <label>
    行員
    <%= form.select :staff_id, @staffs.map { [ it.name, it.id ] },
                    { selected: params[:staff_id], include_blank: "選んでください" }, required: true, autofocus: true %>
  </label>
  <%= form.submit "入る", class: "button primary" %>
<% end %>
