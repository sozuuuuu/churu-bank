<% content_for :title, "#{@account.holder_name} の口座 | ちゅーる銀行" %>

<%# 行員の操作や振込のジョブ、MCP から更新があっても、この画面が morph で更新される %>
<%= customer_stream_from @account %>

<%# celebrate: 通帳に入金が届いたとき・振込が完了したときに、お祝いの演出とトーストを出す %>
<div data-controller="celebrate"
     data-action="arrival:arrived->celebrate#burst transfer-status:settled->celebrate#burst">
  <section class="hero card">
    <%= render "netbank/cat", class: "hero-cat" %>
    <div class="hero-body">
      <p class="muted">口座番号 <%= @account.number %> ・ 開設 <%= jp_date(@account.opened_on) %></p>
      <h1><%= @account.holder_name %> <span class="badge badge-<%= @account.status %>"><%= @account.status_label %></span></h1>
    </div>
    <p class="hero-balance">
      <small>いまの残高</small>
      <%= render "netbank/accounts/amount", account: @account %>
    </p>
  </section>

  <div class="grid">
    <section class="card pop" style="--i: 1">
      <h2><span aria-hidden="true">💌</span> 振込</h2>
      <% if @account.active? %>
        <%# 入力 → 確認 → 確定 の画面遷移は、この Frame の中だけで起きる %>
        <%= turbo_frame_tag "transfer", src: new_account_transfer_path(@account) do %>
          <p class="muted">読み込み中…</p>
        <% end %>
      <% else %>
        <p class="muted">この口座は<%= @account.status_label %>なので振り込めません。</p>
      <% end %>
    </section>

    <section class="card pop" style="--i: 2">
      <h2><span aria-hidden="true">📅</span> 時点指定の残高</h2>
      <%# Frame だけ差し替えつつ、URL（?date=）も進める。morph で更新されても同じ日付で描き直される %>
      <%= form_with url: balance_account_path(@account), method: :get,
                    data: { turbo_frame: "balance", turbo_action: "advance", controller: "autosubmit" } do |f| %>
        <%= f.date_field :date, value: @date, data: { action: "change->autosubmit#submit" } %>
      <% end %>
      <%= turbo_frame_tag "balance", src: balance_account_path(@account, date: @date) %>
    </section>
  </div>

  <section class="card pop" style="--i: 3">
    <h2><span aria-hidden="true">📒</span> 通帳</h2>
    <% if @entries.empty? %>
      <p class="muted">まだ取引はありません。</p>
    <% else %>
      <%# arrival: morph で新しく入ってきた行だけ、ふわっと出す %>
      <ol class="passbook" data-controller="arrival">
        <% @entries.each do |entry| %>
          <li id="<%= dom_id(entry) %>" class="<%= entry.amount.negative? ? "out" : "in" %>"
              data-incoming="<%= entry.amount.positive? %>">
            <span class="passbook-icon" aria-hidden="true"><%= entry.amount.negative? ? "🐾" : "🐟" %></span>
            <span class="passbook-main">
              <span class="passbook-title">
                <%= entry.kind_label %>
                <% if (transfer = @transfers[entry.transfer_id]) && entry.kind == "transfer_out" %>
                  <%# transfer-status: 「処理中」→「完了」に変わったらお祝い %>
                  <span data-controller="transfer-status" data-transfer-status-status-value="<%= transfer.status %>">
                    <%= render "transfers/status", transfer: %>
                  </span>
                <% end %>
                <%# 銀行が取り消した行（取消の行は種類が「取消（入金）」などになっている） %>
                <% if entry.reversed? %><span class="badge badge-reversed">取消済み</span><% end %>
              </span>
              <span class="passbook-sub">
                <% if entry.counterparty %>
                  <% name = @holders.fetch(entry.counterparty, entry.counterparty) %>
                  <%# 相手の口座ページへのリンクは、自分の口座どうしのときだけ %>
                  <%= @my_numbers.include?(entry.counterparty) ? link_to(name, account_path(entry.counterparty)) : name %>
                <% end %>
                <%= entry.memo %>
              </span>
              <span class="passbook-date">
                <%= jp_time(entry.booked_at) %>
                <% if entry.backdated? %><span class="backdated">起算日 <%= jp_date(entry.value_date) %></span><% end %>
              </span>
            </span>
            <span class="passbook-amount">
              <strong class="<%= entry.amount.negative? ? "minus" : "plus" %>"><%= churu(entry.amount, signed: true) %></strong>
              <small>残高 <%= churu(entry.balance_after) %></small>
            </span>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>

  <div id="celebrate-toast" class="toast" data-turbo-permanent data-celebrate-target="toast" role="status" aria-live="polite"></div>
</div>
