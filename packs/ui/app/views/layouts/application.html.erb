<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ちゅーる銀行" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ちゅーる銀行">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# broadcasts_refreshes で届いた更新を、ページ全体の差し替えではなく morph で反映する %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <%# 本文の上に重ねる部品（ねこテーマのセリフ窓。layouts/cat が入れる） %>
    <%= yield :overlay %>
    <header class="site-header">
      <%# ロゴのリンク先は、行員の画面なら管理画面、利用者の画面なら利用者画面（staff_header / customer_header が入れる）。
          ロゴの印はねこテーマだけキラッ（content_for :brand_mark） %>
      <%= link_to content_for(:home_path) || "/", class: "brand" do %><%= content_for?(:brand_mark) ? yield(:brand_mark) : "🐟" %> ちゅーる銀行<% end %>
      <%# メニューは画面のパックごと（packs/admin・packs/customer・packs/shop の layouts）で content_for :nav に入れる %>
      <nav>
        <%= yield :nav %>
        <%# ログイン中の人の名前とログアウト。行員と利用者でログインが別なので、それぞれのパックのヘルパーが入れる %>
        <%= yield :account %>
      </nav>
    </header>

    <main class="container">
      <%# 出すのは notice と alert だけ（ほかのキーは画面の部品が使う。例: 振込完了の演出の flash[:celebrate]） %>
      <% flash.to_hash.slice("notice", "alert").each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>
      <%# ページの頭に差し込む部品（利用者画面のお知らせのねこ。packs/notices の notices_inbox が入れる） %>
      <%= yield :page_top %>
      <%= yield %>
    </main>
  </body>
</html>
