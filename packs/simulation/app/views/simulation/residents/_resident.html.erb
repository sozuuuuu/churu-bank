<%# 住民1匹のカード（たまごっちのような、たまご型の機械と液晶のドット絵）。町を動かす係が Board#resident で、このカードごと書き換える %>
<% pose = pet_pose(resident) %>
<article id="<%= dom_id(resident) %>" class="town-pet shell-<%= resident.temperament %>">
  <div class="pet-shell">
    <p class="pet-name"><%= resident.name %> <span><%= resident.temperament_label %></span></p>
    <div class="pet-screen">
      <%= pixel_pet(pose, size: 96, label: "#{resident.name}: #{Simulation::PixelPetHelper::POSE_LABELS.fetch(pose)}") %>
      <p class="pet-lcd">
        <span><%= Simulation::PixelPetHelper::POSE_LABELS.fetch(pose) %></span>
        <span class="pet-hearts" title="気分 <%= resident.mood || "—" %> / 100"><%= resident.hearts %></span>
      </p>
    </div>
    <div class="pet-buttons" aria-hidden="true"><i></i><i></i><i></i></div>
  </div>
  <dl class="town-resident-facts">
    <dt>いま</dt><dd><%= resident.state || "（まだ起きていない）" %></dd>
    <dt>所持金の見込み</dt><dd><%= resident.money ? churu(resident.money) : "—" %></dd>
    <dt>借金</dt>
    <dd><% if (debt = resident.debt_total).positive? %><span class="badge badge-frozen"><%= churu(debt) %></span><% else %>なし<% end %></dd>
    <dt>最後にしたこと</dt>
    <dd>
      <%= resident.last_action || "—" %>
      <% if resident.last_action_at %><span class="muted small">（<%= jp_time(resident.last_action_at) %>）</span><% end %>
    </dd>
    <dt>手紙</dt>
    <dd>受け取った <%= resident.letters_received %> 通・出した <%= resident.letters_sent %> 通</dd>
    <dt>起こし直し</dt>
    <dd>
      <span class="<%= "badge badge-frozen" if resident.restarts.positive? %>"><%= resident.restarts %> 回</span>
      <% if resident.last_error %><span class="muted small"><%= resident.last_error %></span><% end %>
    </dd>
  </dl>
  <p class="small">
    <%= link_to "口座 #{resident.account_number} の出来事", event_viewer_events_path(account: resident.account_number) %>
  </p>
</article>
