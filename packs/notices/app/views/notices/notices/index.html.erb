<% content_for :title, "お知らせ | ちゅーる銀行" %>
<% if @notices.empty? %>
  <% cat_says "いまはお知らせはないにゃ。のんびりしてってにゃ。" %>
<% else %>
  <% cat_says "銀行からのお知らせはここにまとめてあるにゃ。新しいものには NEW がついてるにゃ。" %>
<% end %>

<header class="page-title">
  <p>銀行から</p>
  <h1><span class="marker">お知らせ</span></h1>
</header>

<% if @notices.empty? %>
  <p class="empty">いまはお知らせがありません。</p>
<% else %>
  <%# 開くと既読になるので、ホバーでの先読み（Turbo の prefetch）はしない %>
  <ul class="notice-list" data-turbo-prefetch="false">
    <% @notices.each do |notice| %>
      <% inbox_read = inbox.read?(notice) %>
      <li id="<%= dom_id(notice) %>"
          class="notice-kind-<%= notice.kind %><%= " is-important" if notice.important? %><%= " is-unread" unless inbox_read %>">
        <%= link_to notice_path(notice), class: "notice-row" do %>
          <span class="notice-row-icon"><%= notice_kind_icon(notice, size: 22) %></span>
          <span class="notice-row-main">
            <span class="notice-bubble-head">
              <span class="notice-chip"><%= notice.kind_label %></span>
              <% if notice.important? %><span class="notice-important">重要</span><% end %>
              <% if inbox_read %>
                <span class="muted small">既読</span>
              <% else %>
                <span class="notice-new">NEW</span>
              <% end %>
            </span>
            <span class="notice-row-title"><%= notice.title %></span>
            <span class="notice-row-sub"><%= notice.body.squish.truncate(70) %></span>
          </span>
          <span class="notice-row-date"><%= jp_date(notice.starts_at) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
