<%= turbo_frame_tag "transaction" do %>
  <div class="confirm">
    <p class="muted">まだ記帳していません。内容を確認してください。</p>
    <dl>
      <dt><%= kind_label %></dt>
      <dd><%= churu(@form[:amount].to_i) %></dd>
      <% if @form[:memo] %>
        <dt>メモ</dt><dd><%= @form[:memo] %></dd>
      <% end %>
      <% if @form[:value_date] %>
        <dt>起算日</dt><dd><%= jp_date(Date.parse(@form[:value_date])) %></dd>
      <% end %>
      <dt>残高</dt>
      <dd><%= churu(@outcome.balance_before) %> → <strong><%= churu(@outcome.balance_after) %></strong></dd>
      <dt>発生するイベント</dt>
      <dd><code><%= @outcome.events.map { it.class.name.demodulize }.join(", ") %></code></dd>
    </dl>

    <%# 確定したら口座ページごと更新したいので、Frame の外（_top）へ遷移させる %>
    <%= form_with url: admin_account_transactions_path(@account), data: { turbo_frame: "_top" } do |f| %>
      <% @form.each do |key, value| %>
        <%= f.hidden_field key, value: value if value %>
      <% end %>
      <%= f.submit "#{kind_label}を確定する", class: "button primary" %>
      <%= link_to "戻る", new_admin_account_transaction_path(@account, @form.compact), class: "button" %>
    <% end %>
  </div>
<% end %>
